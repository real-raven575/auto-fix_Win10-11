{
  "id": "SIG-DEV-001",
  "title": "Device has a problem",
  "category": "Devices",
  "severity": "Medium",
  "match": {
    "any": [
      {
        "source": "PnP"
      },
      {
        "source": "SetupApi"
      },
      {
        "source": "Channel",
        "provider": "Microsoft-Windows-Kernel-PnP",
        "eventId": [
          411
        ]
      }
    ],
    "minCount": 1
  },
  "explain": "{count} device problems were found, such as devices that cannot start or drivers that failed to install. Latest: {lastSeen}.",
  "fixes": [
    "FIX-DEVICE-RESET",
    "ADVICE-DRIVER-REVIEW"
  ]
}
