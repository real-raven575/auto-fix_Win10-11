{
  "id": "SIG-WU-001",
  "title": "Windows Update keeps failing",
  "category": "Updates",
  "severity": "Medium",
  "match": {
    "any": [
      {
        "source": "WindowsUpdate",
        "provider": "Microsoft-Windows-WindowsUpdateClient"
      },
      {
        "source": "Reliability",
        "provider": "Microsoft-Windows-WindowsUpdateClient",
        "eventId": [
          20
        ]
      }
    ],
    "minCount": 2
  },
  "explain": "Windows Update failed {count} times since {firstSeen}, counting failed scans, downloads and installs.",
  "fixes": [
    "FIX-WU-RESET"
  ]
}
